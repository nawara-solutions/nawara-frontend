      "backgrounds": ["--nw-surface-brand-subtle"],
      "min": 4.5
    },
    {
      "foregrounds": ["--nw-text-on-primary"],
      "backgrounds": [
        "--nw-color-primary",
        "--nw-color-primary-hover",
        "--nw-color-primary-active"
      ],
      "min": 4.5
    },
    {
      "foregrounds": ["--nw-text-primary", "--nw-text-secondary"],
      "backgrounds": ["--nw-color-neutral-hover"],
      "min": 4.5
    },
    {
      "foregrounds": ["--nw-text-primary"],
