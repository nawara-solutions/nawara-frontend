      "min": 4.5
    },
    {
      "foregrounds": ["--nw-border-strong", "--nw-focus-ring", "--nw-color-primary"],
      "backgrounds": [
        "--nw-surface-page",
        "--nw-surface-raised",
        "--nw-surface-sunken",
        "--nw-surface-overlay"
      ],
      "min": 3
    },
    {
      "foregrounds": ["--nw-status-success-fg"],
      "backgrounds": ["--nw-status-success-bg"],
      "min": 4.5
    },
    {
      "foregrounds": ["--nw-status-warning-fg"],
      "backgrounds": ["--nw-status-warning-bg"],
      "min": 4.5
    },
    {
      "foregrounds": ["--nw-status-danger-fg"],
