{
  "name": "@nawara-solutions/design-tokens",
  "version": "0.1.0",
  "description": "Nawara foundation design tokens: one DTCG 2025.10 source generating CSS custom properties, a Sass breakpoint module and a resolved-value manifest",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nawara-solutions/nawara-frontend.git",
    "directory": "packages/foundation/design-tokens"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./breakpoints": {
      "sass": "./dist/breakpoints.scss"
    },
    "./manifest.json": "./dist/manifest.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.mjs\"",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "sass": "1.104.1"
  }
}
