{
  "name": "nawara-frontend",
  "version": "0.0.0",
  "private": true,
  "description": "Nawara shared frontend platform: framework-independent foundations and framework-specific shared implementations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nawara-solutions/nawara-frontend.git"
  },
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^24.18.0"
  },
  "workspaces": [
    "packages/*/*"
  ],
  "scripts": {
    "prepare": "husky",
    "check:repo": "node scripts/check-repo.mjs",
    "test:repo": "node --test scripts/check-repo.test.mjs scripts/check-release.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:packages": "npm run build --workspaces --if-present && npm test --workspaces --if-present",
    "validate": "npm run format:check && npm run check:repo && npm run test:repo && npm run test:packages && npm run check:release",
    "check:release": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "prettier": "3.9.9"
  }
}
